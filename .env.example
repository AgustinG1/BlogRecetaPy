# Referencia: Django NO carga este archivo automáticamente.
# Configurar las variables en PowerShell o en Environment de Render.
# Local: DEBUG=1. En Render la depuración siempre queda desactivada.
DEBUG=0
# Para otro proveedor de producción: DJANGO_ENV=production
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
# Generar un valor aleatorio de al menos 50 caracteres. Obligatorio en producción.
SECRET_KEY=
# Usar la URL privada del servicio existente. Obligatoria en producción.
DATABASE_URL=
# Opcional para medios persistentes; copiar el valor privado desde Cloudinary.
CLOUDINARY_URL=
# Opcional: prefijos HTTPS propios separados por comas para imágenes en HTML.
# El prefijo de la cuenta de CLOUDINARY_URL se agrega automáticamente.
HTML_IMAGE_URL_PREFIXES=
